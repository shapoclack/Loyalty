<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:id="root" spacing="14" prefWidth="520" styleClass="page">
    <Label fx:id="title" styleClass="heading"/>
    <Label text="При регистрации бонусная карта создаётся автоматически." wrapText="true" styleClass="muted"/>
    <GridPane hgap="14" vgap="12">
        <columnConstraints><ColumnConstraints minWidth="130"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
        <Label text="ФИО *" GridPane.rowIndex="0"/>
        <TextField fx:id="name" promptText="Иванов Иван Иванович" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Телефон *" GridPane.rowIndex="1"/>
        <TextField fx:id="phone" promptText="+7 (999) 123-45-67" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Email" GridPane.rowIndex="2"/>
        <TextField fx:id="email" promptText="name@example.ru" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="Дата рождения" GridPane.rowIndex="3"/>
        <DatePicker fx:id="birthDate" promptText="дд.мм.гггг" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Label text="Статус" GridPane.rowIndex="4"/>
        <ComboBox fx:id="status" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
    </GridPane>
    <Label fx:id="error" wrapText="true" maxWidth="470" minHeight="42" styleClass="error"/>
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Отмена" onAction="#close" cancelButton="true"/>
        <Button text="Сохранить" onAction="#save" defaultButton="true" styleClass="primary"/>
    </HBox>
</VBox>
