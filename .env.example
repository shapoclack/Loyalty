# Скопируйте файл в .env в корне проекта и укажите свои учётные данные.
# POSTGRES_* настраивают подключение, но не создают базу или пользователя.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=loyalty
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=

# Необязательно: полный JDBC URL вместо POSTGRES_HOST/PORT/DB.
# LOYALTY_DB_URL=jdbc:postgresql://localhost:5432/loyalty
# LOYALTY_DB_USER=your_postgres_user
# LOYALTY_DB_PASSWORD=

# JWT: заготовка для будущего HTTP API. Пока не используется JavaFX-клиентом.
# Задайте свой случайный секрет: не менее 64 случайных байт в Base64.
JWT_SECRET_BASE64=
JWT_ISSUER=loyalty
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Bootstrap-администратор: создание учётной записи пока не реализовано.
BOOTSTRAP_ADMIN_EMAIL=admin@loyalty.local
BOOTSTRAP_ADMIN_NAME="Loyalty Administrator"
BOOTSTRAP_ADMIN_PASSWORD=

# HTTP/CORS: локальная конфигурация для будущего API.
CORS_ALLOWED_ORIGINS=http://localhost:8080
COOKIE_SECURE=false
APP_PORT=8080
